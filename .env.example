# Copy to .env and adjust.

# Admin password (editing games). Admin login is disabled while this is empty.
CHESS_ADMIN_PASSWORD=change-me

# Port on 127.0.0.1 (put a reverse proxy in front).
CHESS_PORT=8200

# URL path the site is served under behind a prefix-stripping proxy, e.g.
# /chess/ for https://host/chess/ (used for the admin cookie). Default: /
#CHESS_BASE_PATH=/

# Set to true behind a reverse proxy that sets X-Forwarded-For / -Proto.
#CHESS_TRUST_PROXY_HEADERS=false

# Optional link back to the site's home page; the proxy can send
# X-Site-Home-Url / X-Site-Home-Title instead.
#CHESS_HOME_URL=/
#CHESS_HOME_TITLE=Home

# Where the database lives (default ./data).
#CHESS_DATA_DIR=
